# Environment Configuration
NODE_ENV=development
# Port 5001 is used because macOS Monterey/Ventura/Sonoma uses port 5000 for AirPlay Receiver
PORT=5001

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=agrislot
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# Security and Authentication
JWT_SECRET=agrislot_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# Google Identity Services (OAuth 2.0 Web Client)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# CORS Frontend Origin
FRONTEND_ORIGIN=http://localhost:3000
